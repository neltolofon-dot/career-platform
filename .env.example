# Neon — DATABASE_URL est l'URL POOLÉE (runtime), DIRECT_URL est l'URL DIRECTE (migrations).
# Les confondre fait échouer `prisma migrate` de façon illisible.
DATABASE_URL=
DIRECT_URL=

# Upstash Redis (REST) — noms injectés automatiquement par l'intégration Vercel-Upstash,
# lus sans configuration par Redis.fromEnv().
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gemini (chat + embeddings) — clé serveur uniquement, jamais NEXT_PUBLIC_
GEMINI_API_KEY=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Auth maison — secret pour signer/dériver les sessions
SESSION_SECRET=

# Seed du compte admin unique (aucune route d'inscription)
ADMIN_EMAIL=
ADMIN_PASSWORD=
